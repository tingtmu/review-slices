{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'top=$(git -C \"${CLAUDE_PROJECT_DIR:-.}\" rev-parse --show-toplevel 2>/dev/null) && [ -f \"$top/.githooks/agent_hook.py\" ] && exec python3 \"$top/.githooks/agent_hook.py\"' 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
